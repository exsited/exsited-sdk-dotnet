# Files this repository never tracks.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Log files
*.log

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Generated by Windows
Thumbs.db
ehthumbs.db

# Applications
*.exe

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Editors
.vs/
*.user
*.suo
*.cache
*.vscode/
*.swp
*.swo

# .NET build output
bin/
obj/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
project.lock.json
artifacts/

# NuGet
packages/
*.nupkg

# Project conventions
# tests/ is tracked: 3,060 live API cases with no mock layer. They read
# credentials at runtime from this repo's own .env (copy .env.example; nothing
# secret is committed).

# Local working area: parked artifacts, live-test drivers, notes.
/scratchpad/

# Credentials for live verification. Never committed. A filled-in .env holds a
# working client id and secret; .env.example documents the variables and is
# meant to be committed.
.env
.env.*
!.env.example

# A root-level location for stale build output, so `dotnet build` at the root
# cannot pick it up.
/verification/

# Local analysis output and tooling config: never part of a release.
/notes/

# Local coding-agent settings
.claude/settings.local.json

# Captured live responses: real bodies from the dev instance carry real people's
# email, address and phone fields.
captures/
sweep_result.json

# The token cache. Its default path is the per-user cache directory, but a
# tokenCachePath pointed at the repository would hold a live access token,
# refresh token, client id and client secret.
token.json
*_token.json
