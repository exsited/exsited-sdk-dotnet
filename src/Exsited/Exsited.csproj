<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- No PackageReference on purpose: System.Text.Json and HttpClient are in the BCL. -->

    <PackageId>Exsited</PackageId>
    <Version>4.0.0</Version>
    <Authors>Ashiq Rahman &lt;ashiq@webalive.com.au&gt;</Authors>
    <Company>Exsited</Company>
    <Description>.NET SDK for the Exsited v4 REST API.</Description>
    <RootNamespace>Exsited</RootNamespace>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/exsited/exsited-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>exsited;sdk;api;rest;client;billing</PackageTags>

    <!-- Documentation is generated, and a member whose name and signature say everything
         does not carry a summary; CS1591 is suppressed so that stays a choice. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- No InternalsVisibleTo: the live suite drives this SDK through its public surface. -->

</Project>
